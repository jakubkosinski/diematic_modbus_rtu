# Copy to .env and adjust. Blank values are treated as unset.

# --- RS485-to-TCP converter in front of the boiler (required) --------------------------------
DIEMATIC_HOST=192.168.1.50
DIEMATIC_PORT=20108

# Register map: diematic_isystem (default), diematic3_legacy, or a path to your own YAML file
DIEMATIC_MAP=diematic_isystem
# Registers or groups to leave out (comma separated), e.g. features your boiler does not have:
# solar, circuit_c, heat_pump, cascade, stop_periods. Their entities are removed from Home Assistant.
DIEMATIC_DISABLED_REGISTERS=
# Language of entity names and enum values: pl or en
DIEMATIC_LANGUAGE=pl
# Modbus address of the regulator; blank uses the address from the map (10)
DIEMATIC_SLAVE_ADDRESS=
# Refuse every write coming from MQTT
DIEMATIC_READ_ONLY=false
# The Diematic bus expects one extra zero byte after every frame we send
DIEMATIC_TRAILING_ZERO=true
# Seconds between polls of measurements (fast) and settings/programs (slow)
DIEMATIC_FAST_INTERVAL=30
DIEMATIC_SLOW_INTERVAL=300
# Seconds without a valid answer before the boiler counts as offline
DIEMATIC_OFFLINE_AFTER=120
# Keep the boiler clock in sync with this host
DIEMATIC_CLOCK_SYNC=false
# Time zone of the boiler clock (also used by the Boiler time sensor). Blank: the TZ variable or
# the machine's zone, else UTC with a warning. Set it in a container.
DIEMATIC_TIMEZONE=Europe/Warsaw
# DEBUG, INFO, WARNING, ERROR, CRITICAL
DIEMATIC_LOG_LEVEL=INFO

# --- MQTT broker ------------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=diematic
MQTT_TLS=false
# CA certificate inside the container (mount it), used when MQTT_TLS=true
MQTT_TLS_CA=
MQTT_TLS_INSECURE=false
MQTT_QOS=1

# Topics are published under this prefix, e.g. diematic/outdoor_temp
MQTT_TOPIC_PREFIX=diematic
# Home Assistant discovery
# Make entities unavailable while the boiler is silent (default: keep the last value)
MQTT_BOILER_AVAILABILITY=false
MQTT_DISCOVERY=true
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_NODE_ID=diematic
MQTT_DEVICE_NAME=Diematic boiler
